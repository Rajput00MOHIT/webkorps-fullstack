# Corp Talk Backend Environment Configuration

# Server
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/corp_talk_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Auth & Security
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Multi-Tenancy (Default dogfood tenant: Webkorps)
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_TENANT_NAME=Webkorps
DEFAULT_TENANT_DOMAIN=webkorps.com

# Local / Self-Hosted Intelligence (Zero-Cost First)
LOCAL_OLLAMA_URL=http://localhost:11434
LOCAL_EMBEDDING_MODEL=bge-small-en-v1.5
LOCAL_LLM_MODEL=llama3.1:8b-instruct

# Search Provider Configuration (Pluggable: local SearxNG / DuckDuckGo FOSS)
SEARCH_PROVIDER=duckduckgo
SEARXNG_URL=http://localhost:8080

# External AI Provider (Optional Fallbacks - Never hard dependencies)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# CRM Integration (Webhook Adapter)
CRM_WEBHOOK_URL=
